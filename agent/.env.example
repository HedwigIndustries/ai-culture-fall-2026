# Скопировать в agent/.env и заполнить. agent/.env не попадает в git, Docker-образ и архив.
# OpenRouter (прототип): OpenAI-совместимый API
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.5-plus-20260420
OPENAI_REASONING=off
# GigaChat (целевой вариант для банка)
GIGACHAT_CREDENTIALS=
GIGACHAT_CA_BUNDLE=
# GIGACHAT_MODEL=GigaChat-2-Pro
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
